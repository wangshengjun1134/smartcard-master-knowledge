# 应用配置
APP_NAME=SmartCard Master Knowledge Base
DEBUG=false

# Qdrant 配置
QDRANT_HOST=localhost
QDRANT_PORT=6333

# OpenAI 配置
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-4

# 嵌入模型配置
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Docling 模型路径
DOCLING_MODELS_PATH=D:/softdata/workspaces/ai-models/docling-models

# VLM 配置
# 后端类型: local 或 openai
VLM_BACKEND_TYPE=openai

# OpenAI 兼容后端配置（当 VLM_BACKEND_TYPE=openai 时使用）
VLM_OPENAI_API_KEY=sk-sp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VLM_OPENAI_BASE_URL=https://coding-intl.dashscope.aliyuncs.com/v1
VLM_OPENAI_MODEL=qwen-vl-max

# 本地后端配置（当 VLM_BACKEND_TYPE=local 时使用）
VLM_LOCAL_MODEL_PATH=D:/softdata/workspaces/ai-models/Qwen3-VL-8B-Instruct
